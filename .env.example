# --- Postgres (used by the db container) ---
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime

# --- Backend (api + worker) ---
DATABASE_URL=postgresql+asyncpg://uptime:uptime@db:5432/uptime
# Separate database used only by pytest (created by db/init on first start)
TEST_DATABASE_URL=postgresql+asyncpg://uptime:uptime@db:5432/uptime_test
LOG_LEVEL=INFO

# --- Worker / check behaviour ---
CHECK_TIMEOUT_SECONDS=10
WORKER_CONCURRENCY=20
WORKER_POLL_SECONDS=2
FAILURE_THRESHOLD=3
RETRY_INTERVAL_SECONDS=30
MAX_REDIRECTS=5
RETENTION_DAYS=30

# --- Demo data ---
SEED_DEMO=true

